         <dc:format>application/pdf</dc:format>
         <dc:source>fmed-09-998623.tex</dc:source>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Hair regrowth treatment efficacy and resistance in androgenetic alopecia: A systematic review and continuous Bayesian network meta-analysis</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Background: Androgenetic alopecia (AGA) affects almost half the population, and several treatments intending to regenerate a normal scalp hair phenotype are used.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Peter R. Feldman</rdf:li>
